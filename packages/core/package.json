{
  "name": "@modexagents/core",
  "version": "0.3.1",
  "description": "Core extraction, canonical SKILLS.md serialization, hash-chained provenance, and registry client for modex-cli",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "modex",
    "skills",
    "skills.md",
    "provenance",
    "ai-agents",
    "anthropic"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rickyjs1955/modex-cli.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/rickyjs1955/modex-cli/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/rickyjs1955/modex-cli/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.0",
    "@mozilla/readability": "^0.6.0",
    "epub2": "^3.0.2",
    "linkedom": "^0.18.12",
    "tinyglobby": "^0.2.16",
    "unpdf": "^1.6.2",
    "uuid": "^14.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/uuid": "^10.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
