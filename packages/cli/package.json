{
  "name": "@modexagents/cli",
  "version": "0.5.0",
  "description": "modex-cli — author SKILLS.md from a corpus on your own machine",
  "license": "MIT",
  "type": "module",
  "bin": {
    "modex": "./bin/modex.mjs"
  },
  "main": "./dist/index.js",
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "modex",
    "skills",
    "skills.md",
    "cli",
    "provenance",
    "ai-agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rickyjs1955/modex-cli.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/rickyjs1955/modex-cli#readme",
  "bugs": {
    "url": "https://github.com/rickyjs1955/modex-cli/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dependencies": {
    "@modexagents/core": "workspace:^",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "tsup": "^8.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
