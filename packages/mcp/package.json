{
  "name": "@modexagents/mcp",
  "version": "0.8.0",
  "description": "Model Context Protocol server exposing modex authoring verbs (feed, agents, bind, aspirations) to MCP hosts like Claude Code and Cursor.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "modex-mcp": "./bin/modex-mcp.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "modex",
    "skills",
    "skills.md",
    "mcp",
    "model-context-protocol",
    "ai-agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rickyjs1955/modex-cli.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/rickyjs1955/modex-cli/tree/main/packages/mcp#readme",
  "bugs": {
    "url": "https://github.com/rickyjs1955/modex-cli/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dependencies": {
    "@modexagents/core": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "tsup": "^8.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
